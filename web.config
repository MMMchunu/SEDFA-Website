<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- URL Rewrite Rules -->
    <rewrite>
      <rules>

        <!-- Force HTTPS -->
        <rule name="Redirect HTTP to HTTPS" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Force www version -->
        <rule name="Redirect non-www to www" enabled="true" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^sedfa\.org\.za$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.sedfa.org.za/{R:1}" redirectType="Permanent" />
        </rule>

      </rules>

      <!-- Outbound Rules (modify response headers) -->
      <outboundRules>

        <!-- HTML pages: always revalidate with the server -->
        <rule name="No cache for HTML" preCondition="IsHTML">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>

        <preConditions>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>

      </outboundRules>
    </rewrite>

    <!-- Default Documents -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.htm" />
        <add value="default.html" />
      </files>
    </defaultDocument>

    <!-- Static Compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- Request Filtering -->
    <security>
      <requestFiltering removeServerHeader="true">

        <hiddenSegments applyToWebDAV="true">
          <add segment="bin" />
          <add segment="node_modules" />
          <add segment=".git" />
          <add segment=".svn" />
          <add segment=".env" />
          <add segment=".htaccess" />
        </hiddenSegments>

        <verbs allowUnlisted="false" applyToWebDAV="true">
          <add verb="GET" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="POST" allowed="true" />
        </verbs>

        <requestLimits maxUrl="4096" maxQueryString="2048" maxAllowedContentLength="52428800" />

        <fileExtensions allowUnlisted="true" applyToWebDAV="true">
          <add fileExtension=".exe" allowed="false" />
          <add fileExtension=".dll" allowed="false" />
          <add fileExtension=".msi" allowed="false" />
          <add fileExtension=".bat" allowed="false" />
          <add fileExtension=".cmd" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".sh" allowed="false" />
          <add fileExtension=".jar" allowed="false" />
          <add fileExtension=".com" allowed="false" />
          <add fileExtension=".php" allowed="false" />
          <add fileExtension=".asp" allowed="false" />
          <add fileExtension=".aspx" allowed="false" />
          <add fileExtension=".jsp" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".pl" allowed="false" />
          <add fileExtension=".cgi" allowed="false" />
          <add fileExtension=".config" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".cs" allowed="false" />
          <add fileExtension=".vb" allowed="false" />
          <add fileExtension=".java" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".sqlite" allowed="false" />
          <add fileExtension=".mdf" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".old" allowed="false" />
          <add fileExtension=".tmp" allowed="false" />
          <add fileExtension=".backup" allowed="false" />
        </fileExtensions>

      </requestFiltering>
    </security>

    <!-- Custom Error Pages -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="400" />
      <remove statusCode="403" />
      <remove statusCode="404" />
      <remove statusCode="500" />
      <remove statusCode="502" />
      <remove statusCode="503" />
      <remove statusCode="504" />

      <error statusCode="400" path="/error.html" responseMode="ExecuteURL" />
      <error statusCode="403" path="/error.html" responseMode="ExecuteURL" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
      <error statusCode="500" path="/error.html" responseMode="ExecuteURL" />
      <error statusCode="502" path="/error.html" responseMode="ExecuteURL" />
      <error statusCode="503" path="/error.html" responseMode="ExecuteURL" />
      <error statusCode="504" path="/error.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Static Content and MIME Types -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" cacheControlCustom="public, must-revalidate" />

      <remove fileExtension=".xml" />
      <remove fileExtension=".txt" />
      <remove fileExtension=".webmanifest" />
      <remove fileExtension=".webp" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".ttf" />
      <remove fileExtension=".svg" />
      <remove fileExtension=".json" />
      <remove fileExtension=".mp4" />
      <remove fileExtension=".webm" />
      <remove fileExtension=".ogv" />
      <remove fileExtension=".eot" />
      <remove fileExtension=".js" />
      <remove fileExtension=".css" />

      <mimeMap fileExtension=".xml" mimeType="application/xml" />
      <mimeMap fileExtension=".txt" mimeType="text/plain" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
      <mimeMap fileExtension=".ogv" mimeType="video/ogg" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <mimeMap fileExtension=".js"  mimeType="text/javascript" />
      <mimeMap fileExtension=".css" mimeType="text/css" />
    </staticContent>

    <!-- Security Headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <remove name="X-AspNet-Version" />
        <remove name="X-AspNetMvc-Version" />

        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />

        <!-- Only keep HSTS enabled if HTTPS certificate is valid -->
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />

        <!-- CSP adjusted for static HTML, Google Analytics, Google Maps and fonts -->
        <add name="Content-Security-Policy" value="default-src 'self'; object-src 'none'; base-uri 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com https://maps.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; frame-src 'self' https://www.google.com https://www.google.com/maps https://www.google.com/maps/d https://maps.google.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://maps.googleapis.com https://maps.gstatic.com; form-action 'self' https://formbold.com;" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>